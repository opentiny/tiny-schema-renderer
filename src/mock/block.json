{
  "componentName": "TestBlock",
  "state": {
    "title": "Hello, World!"
  },
  "children": [
    {
      "componentName": "Slot",
      "props": {
        "name": "header",
        "params": [
          {
            "name": "title",
            "value": {
              "type": "JSExpression",
              "value": "this.state.title"
            }
          }
        ]
      },
      "children": [
        {
          "componentName": "Text",
          "props": {
            "text": {
              "type": "JSExpression",
              "value": "`Built-in header: ${this.state.title}`"
            },
            "style": {
              "color": "red"
            }
          }
        }
      ]
    },
    {
      "componentName": "Text",
      "props": {
        "text": {
          "type": "JSExpression",
          "value": "`Text from input: ${this.props.text}`"
        },
        "onClick": {
          "type": "JSFunction",
          "value": "function(event) { this.dispatchEvent('clickText', event)}"
        }
      }
    },
    {
      "componentName": "Slot",
      "props": {
        "description": "default slot"
      }
    },
    {
      "componentName": "Slot",
      "props": {
        "description": "Slot without params and children",
        "name": "footer"
      }
    }
  ],
  "schema": {
    "properties": [
      {
        "label": { "zh_CN": "基础属性" },
        "content": [
          {
            "property": "text",
            "type": "string",
            "description": { "zh_CN": "正文展示的文本" }
          }
        ]
      }
    ],
    "events": {
      "onClickText": {
        "type": "event",
        "description": { "zh_CN": "点击文本时触发事件" },
        "functionInfo": {
          "params": [
            {
              "name": "event",
              "type": "Object",
              "description": { "zh_CN": "点击事件对象" }
            }
          ],
          "returns": {}
        }
      }
    },
    "slots": {
      "header": {
        "description": { "zh_CN": "自定义头部；未提供时渲染兜底内容" },
        "params": [
          {
            "name": "title",
            "type": "string",
            "description": { "zh_CN": "标题" }
          }
        ]
      },
      "footer": {
        "description": { "zh_CN": "底部显示的内容" }
      },
      "default": {
        "description": { "zh_CN": "主要区域显示的内容" }
      }
    }
  }
}
