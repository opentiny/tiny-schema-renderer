{
  "componentName": "TestBlock",
  "state": {
    "title": "Hello, World!"
  },
  "children": [
    {
      "componentName": "Slot",
      "props": {
        "name": "header",
        "params": [
          {
            "name": "title",
            "value": {
              "type": "JSExpression",
              "value": "this.state.title"
            }
          }
        ]
      },
      "children": [
        {
          "componentName": "Text",
          "props": {
            "text": {
              "type": "JSExpression",
              "value": "`Built-in header: ${this.state.title}`"
            },
            "style": {
              "color": "red"
            }
          }
        }
      ]
    },
    {
      "componentName": "Text",
      "props": {
        "text": {
          "type": "JSExpression",
          "value": "`Text from input: ${this.props.text}`"
        },
        "onClick": {
          "type": "JSFunction",
          "value": "function(event) { this.dispatchEvent('clickText', event)}"
        }
      }
    },
    {
      "componentName": "Slot",
      "props": {
        "description": "default slot"
      }
    },
    {
      "componentName": "Slot",
      "props": {
        "description": "Slot without params and children",
        "name": "footer"
      }
    }
  ],
  "inputs": {
    "text": {
      "type": "string"
    }
  },
  "outputs": {
    "clickText": {
      "type": "string"
    }
  }
}
